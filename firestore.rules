rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    function myClientId() {
      return isSignedIn() ? myProfile().clientId : null;
    }

    function belongsToClient(clientId) {
      return isSignedIn() && myProfile().role == 'client' && myProfile().clientId == clientId;
    }

    // isAdmin()/belongsToClient()를 `isAdmin() || belongsToClient(x)`로 나열하면 myProfile()
    // (=users 문서 조회)이 한 번의 판정에 최대 3번 호출된다. 규칙 안의 문서 조회는 요청당
    // 횟수 제한이 있으므로 let으로 프로필을 한 번만 읽어 1회로 고정한다.
    //
    // 주의: 이 함수를 list 규칙에 쓰면 resource.data.clientId에 의존하게 되는데, Firestore의
    // list 규칙은 문서를 하나씩 걸러주는 필터가 아니라 "쿼리 제약조건만 보고 결과 전체가
    // 규칙을 만족함이 증명되어야" 통과한다. 따라서 클라이언트가 보내는 쿼리는 반드시
    // where('clientId','==',내clientId)를 포함해야 한다(projects는 원래 그랬고, tasks는
    // 빠져 있어서 고객 화면에서만 업무 목록이 통째로 거부되는 버그가 있었다).
    function adminOrClientOf(clientId) {
      let p = myProfile();
      return p.role == 'admin' || (p.role == 'client' && p.clientId == clientId);
    }

    // 중국 파트너 공장 등 협력사 계정 — 지정된 프로젝트(projectIds)의 일정·업무·첨부 자료·
    // 코멘트만 보게 하려는 용도다. clients/contracts/quoteRequests/purchaseOrders 등 금액이
    // 얽힌 컬렉션에는 이 함수를 아예 쓰지 않아서, 협력사 계정은 그 쪽으로 접근할 방법 자체가
    // 없다(전부 기본값인 deny로 막힘) — "협력사에게 계약·견적은 절대 노출 금지" 요구사항을
    // 개별 컬렉션마다 따로 막는 게 아니라 애초에 허용 목록에서 빼는 방식으로 지킨다.
    function belongsToPartnerProject(projectId) {
      let p = myProfile();
      return p.role == 'partner' && projectId in p.get('projectIds', []);
    }

    function adminOrClientOrPartnerOf(clientId, projectId, hiddenFromPartner) {
      let p = myProfile();
      return p.role == 'admin'
        || (p.role == 'client' && p.clientId == clientId)
        || (p.role == 'partner' && projectId in p.get('projectIds', []) && hiddenFromPartner != true);
    }

    // ---- users ----
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      // list 규칙은 쿼리 대상 문서 하나하나에 대해 개별 재평가되므로(Firestore 공식 동작),
      // 조건 없이 isSignedIn()만 걸어두면 앱의 where절과 무관하게 로그인한 아무나 전체
      // users 컬렉션(다른 회사 팀원 포함)을 그대로 읽어갈 수 있었다 — 같은 클라이언트
      // 팀원 조회(where clientId==)와 담당 관리자 조회(where role=='admin') 두 쿼리
      // 패턴만 실제로 필요하므로 그 조건만 허용한다.
      allow list: if isAdmin() || belongsToClient(resource.data.clientId) || resource.data.role == 'admin';
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'fcmTokens', 'notificationPrefs'])
      );
    }

    // ---- clients ----
    match /clients/{clientId} {
      allow get: if isAdmin() || belongsToClient(clientId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- projects ----
    match /projects/{projectId} {
      // clientVisible이 false면(세팅 중인 신규 프로젝트 기본값) 관리자가 아직 "고객에게 공개"를
      // 켜기 전이라 클라이언트에게는 완전히 안 보여야 한다. 필드가 아예 없는(이 기능 이전에
      // 만들어진) 기존 프로젝트는 true로 취급해 지금까지 보이던 게 갑자기 사라지지 않게 한다.
      allow get: if isAdmin() || (
        belongsToClient(resource.data.clientId) &&
        resource.data.get('clientVisible', true) != false
      ) || belongsToPartnerProject(projectId);
      // list 규칙은 문서별로 재평가되지만, 쿼리 결과 중 단 하나라도 규칙을 통과 못 하면
      // Firestore는 (그 문서만 거르는 게 아니라) 쿼리 전체를 permission-denied로 실패시킨다.
      // clientVisible 조건까지 여기 걸면, 고객이 비공개 프로젝트를 하나라도 갖는 순간 그
      // 고객의 프로젝트 목록 쿼리 자체가 통째로 실패한다 — 그래서 list는 클라이언트 소유
      // 여부(다른 회사 데이터 유출 방지)까지만 검사하고, clientVisible에 따라 개별 프로젝트를
      // 숨기는 건 앱 쪽에서(listenProjectsByClient) 걸러낸다. get은 그대로 clientVisible도
      // 함께 검사해 직접 URL로 들어오는 것까지 막는다.
      allow list: if isSignedIn() && (adminOrClientOf(resource.data.clientId) || belongsToPartnerProject(projectId));
      allow create, delete: if isAdmin();
      // 캘린더 구독 링크는 클라이언트도 최초 생성할 수 있어야 하므로 그 필드만 예외적으로 허용
      allow update: if isAdmin() || (
        belongsToClient(resource.data.clientId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calendarToken'])
      );
    }

    // ---- tasks ----
    match /tasks/{taskId} {
      // 업무 자체엔 공개 여부 필드가 따로 없다 — 소속 프로젝트가 비공개면 그 프로젝트의 업무도
      // 똑같이 안 보여야 하므로, 부모 projects 문서를 조회해 그 값을 그대로 따른다.
      allow get: if isAdmin() || (
        belongsToClient(resource.data.clientId) &&
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.get('clientVisible', true) != false
      ) || (belongsToPartnerProject(resource.data.projectId) && resource.data.get('hiddenFromPartner', false) != true);
      // list에서는 clientVisible을 검사하지 않는다(위 get과 다른 점). list 규칙은 쿼리
      // 제약조건만으로 판정되므로 부모 projects 문서를 들여다보는 조건은 쿼리로 증명할 수
      // 없다 — projects의 list가 같은 이유로 clientVisible을 앱에서 거르는 것과 동일하다.
      // 비공개 프로젝트는 projects의 get 규칙과 앱 필터(listenProjectsByClient)가 막는다.
      // 클라이언트 쿼리는 반드시 where('clientId','==',내clientId)를 포함해야 한다
      // (listenTasksByProject가 clientId 인자를 받는 이유). 협력사는 clientId가 없으므로
      // where('projectId','==',...)만으로 조회한다(관리자와 동일한 쿼리 형태).
      // hiddenFromPartner는 여기(list)서 검사하면 안 된다 — clientVisible과 똑같은 함정:
      // list 규칙은 쿼리 결과 문서 중 하나라도 조건을 통과 못 하면 그 문서만 걸러지는 게
      // 아니라 쿼리 전체가 permission-denied로 실패한다. 프로젝트에 숨김 업무가 하나만
      // 있어도 협력사의 업무 목록 전체가 사라지는 사고가 났었다. get(단건 조회)에서만
      // 검사하고, list 결과에서 숨김 업무를 빼는 건 앱 쪽(listenTasksByProject 호출부)에서
      // 필터링한다.
      allow list: if isSignedIn() && (adminOrClientOf(resource.data.clientId) || belongsToPartnerProject(resource.data.projectId));
      allow create, delete: if isAdmin();
      // 상태/진행률/체크리스트는 관리자 전용 관리 지표라 클라이언트는 못 건드리게 막고,
      // 확인/승인 요청 응답에 필요한 필드만 예외적으로 열어둔다.
      allow update: if isAdmin() || (
        belongsToClient(resource.data.clientId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['needsDecision', 'decisionHistory', 'updatedAt'])
      );

      match /comments/{commentId} {
        // 아래 list 규칙들은 이 경로(tasks/{taskId}/comments)로 직접 조회할 때만 적용된다.
        // collectionGroup("comments") 쿼리(전역 검색용)는 이 중첩 규칙을 전혀 적용받지 않고
        // 파일 하단의 별도 {pathSegs=**} 와일드카드 규칙으로만 판단된다(Firestore 공식 동작).
        allow list: if isAdmin();
        allow get, list: if belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId)
          || (belongsToPartnerProject(get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId)
              && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('hiddenFromPartner', false) != true);
        allow get: if isAdmin();
        allow create: if (adminOrClientOrPartnerOf(
            get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId,
            get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId,
            get(/databases/$(database)/documents/tasks/$(taskId)).data.get('hiddenFromPartner', false)
          )) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || resource.data.authorId == request.auth.uid;
      }

      match /files/{fileId} {
        allow list: if isAdmin();
        // list는 visibleToClient를 검사하지 않는다 — hiddenFromPartner와 같은 함정(쿼리 결과
        // 문서 중 하나라도 조건을 못 넘으면 쿼리 전체가 거부됨)이라, 협력사가 올린 비공개
        // 자료가 하나만 있어도 클라이언트의 파일 목록 전체가 사라지는 사고가 난다. 목록에서
        // 숨기는 건 앱 쪽(ProjectFilesTab.tsx, FileUploader.tsx)에서 필터링한다.
        allow list: if belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId)
          || belongsToPartnerProject(get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId);
        allow get: if isAdmin();
        // get(단건 조회)에서는 visibleToClient를 그대로 적용해, 직접 URL 등으로 비공개 자료에
        // 접근하는 것까지 막는다 — 협력사가 올렸지만 관리자가 아직 승인 전인 자료.
        allow get: if (belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId)
              && resource.data.get('visibleToClient', true) != false)
          || (belongsToPartnerProject(get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId)
              && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('hiddenFromPartner', false) != true);
        allow create: if (adminOrClientOrPartnerOf(
            get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId,
            get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId,
            get(/databases/$(database)/documents/tasks/$(taskId)).data.get('hiddenFromPartner', false)
          )) && request.resource.data.uploadedBy == request.auth.uid;
        // AI 형상 분석 결과 기록용(aiAnalysis)과, 협력사 자료를 고객에게 공개 전환하는 용도
        // (visibleToClient)만 수정 가능 — 후자는 관리자만 건드릴 수 있다.
        allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiAnalysis', 'visibleToClient']))
          || (belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiAnalysis']));
        allow delete: if isAdmin() || resource.data.uploadedBy == request.auth.uid;

        // 3D 모델 위 리뷰 핀 — 같은 파일의 핀들은 전부 같은 소속 업무(clientId)를 공유하므로,
        // list 쿼리가 "결과가 섞여서 하나 때문에 전체 실패"하는 문제 없이 그대로 조건을 걸 수 있다.
        match /annotations/{annotationId} {
          allow list, get: if isAdmin() || belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId);
          allow create: if (isAdmin() || belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId))
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if isAdmin() || resource.data.createdBy == request.auth.uid;
          allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;

          match /comments/{commentId} {
            allow list, get: if isAdmin() || belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId);
            allow create: if (isAdmin() || belongsToClient(get(/databases/$(database)/documents/tasks/$(taskId)).data.clientId))
              && request.resource.data.authorId == request.auth.uid;
            allow update, delete: if isAdmin() || resource.data.authorId == request.auth.uid;
          }
        }
      }
    }

    // ---- 전역 검색용 collectionGroup 쿼리 규칙 ----
    // collectionGroup() 쿼리는 위쪽의 tasks/{taskId}/comments 같은 고정 경로 중첩 규칙을
    // 전혀 적용받지 않으며, 반드시 {path=**} 와일드카드로 별도 선언해야 매칭된다.
    // (에뮬레이터로 직접 검증: 중첩 규칙만 있으면 admin이어도 항상 permission-denied)
    match /{pathSegs=**}/comments/{commentId} {
      allow list: if isAdmin();
    }
    match /{pathSegs=**}/files/{fileId} {
      allow list: if isAdmin();
    }

    // ---- notifications ----
    // create는 "본인 것만"으로 못 막는다 — 댓글 알림(CommentThread.tsx)이나 발주 상태 변경
    // 알림(purchaseOrders.ts)처럼 상대방에게 알림을 보내는 게 정상 기능이기 때문이다.
    // 대신 type을 src/lib/types.ts의 NotificationType과 동일한 화이트리스트로 제한해,
    // 로그인한 계정이 앱 화면을 거치지 않고 임의의 내용(피싱 등)으로 알림을 지어 넣는
    // 경로를 최소한으로 막는다 — 여기 목록은 NotificationType과 항상 맞춰서 유지할 것.
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.type in [
        "assigned", "status_change", "comment", "unblocked", "due_soon", "overdue",
        "rescheduled", "weekly_summary", "notice", "decision_needed", "inquiry",
        "inquiry_answered", "quote_request", "quote_response", "purchase_order",
        "order_status_change", "order_cancel_request", "contract_signed",
        "contract_revision_requested", "contract_expiring"
      ];
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---- workflow templates (관리자 전용 도구) ----
    match /templates/{templateId} {
      allow read, write: if isAdmin();
    }

    // ---- quote drafts ("견적서 바로 만들기" 임시저장, 관리자 전용) ----
    match /quoteDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // ---- notices (공지사항) ----
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // 클라이언트는 자신의 읽음 처리(readBy)만 갱신 가능
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }

    // ---- inquiries (문의하기) ----
    match /inquiries/{inquiryId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid)
        || request.resource.data.userId == 'website';
      // 작성자 본인은 제목·내용만 수정 가능(상태·답변 등은 관리자만)
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---- quote requests (견적 요청, 사이트 공개 폼) ----
    match /quoteRequests/{quoteId} {
      allow list, get, update, delete: if isAdmin();
      allow create: if true;

      // 상담(대면/화상 미팅) 중 이메일 등으로 추가로 받는 자료 아카이브
      match /files/{fileId} {
        allow list, get, create, update, delete: if isAdmin();
      }
    }

    // ---- client products (고객별 발주 제품 카탈로그) ----
    match /clientProducts/{productId} {
      allow get: if isAdmin() || belongsToClient(resource.data.clientId);
      allow list: if isAdmin() || belongsToClient(resource.data.clientId);
      allow create, update, delete: if isAdmin();
    }

    // ---- client product internal (매입/통관 내부 정보, 관리자 전용) ----
    match /clientProductInternal/{productId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    // ---- purchase orders (발주) ----
    match /purchaseOrders/{orderId} {
      allow get: if isAdmin() || belongsToClient(resource.data.clientId);
      allow list: if isAdmin() || belongsToClient(resource.data.clientId);
      // "발주 없이 직접 등록"(관리자가 클라이언트 담당자 대신 청구서용 발주를 생성하는 기능)은
      // orderedBy가 관리자 본인이 아니라 그 담당자의 uid로 저장되므로, isAdmin() 예외가 없으면
      // 관리자 계정으로는 항상 권한 거부로 조용히 실패한다.
      allow create: if isAdmin() || (
        belongsToClient(request.resource.data.clientId) &&
        request.resource.data.orderedBy == request.auth.uid
      );
      // 발주 작성자 본인은 취소 요청 필드만 예외적으로 수정 가능 (그 외 모든 필드는 관리자 전용)
      allow update: if isAdmin() || (
        resource.data.orderedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelRequested', 'cancelRequestedAt', 'cancelReason', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // ---- contracts (계약 관리/전자서명) ----
    // 비로그인 상대방(서명자)의 모든 접근은 Cloud Functions(Admin SDK, 이메일 대조로 본인확인)를
    // 통해서만 이뤄지므로, 이 컬렉션 자체는 완전히 관리자 전용으로 잠가도 된다.
    match /contracts/{contractId} {
      allow read, write: if isAdmin();
    }

    // ---- contract templates (계약서 본문 재사용 템플릿, 관리자 전용) ----
    match /contractTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // ---- system alerts (알림 발송 실패 등 시스템 경고, 관리자 전용) ----
    // 생성은 Cloud Functions(Admin SDK)만 한다 — Admin SDK는 규칙을 우회하므로 create를
    // 막아두면 클라이언트가 가짜 경고를 심을 수 없다.
    match /systemAlerts/{alertId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ---- supplier products (매입 전용 품목: 금형·부자재 등, 관리자 전용) ----
    // 고객 제품(clientProducts)과 달리 clientId가 없다 — supplierOrders와 같은 원칙으로,
    // 고객에게 열어줄 근거 자체를 만들지 않는다.
    match /supplierProducts/{productId} {
      allow read, write: if isAdmin();
    }

    // ---- supplier orders (구매발주: 핸디핸드 → 해외 공급사, 관리자 전용) ----
    // 매출 쪽 purchaseOrders와 달리 이 문서에는 clientId가 아예 없다. 필드가 없으면 "고객은
    // 자기 것만" 식으로 규칙을 여는 것 자체가 불가능해서, 원가·마진이 고객에게 노출될 경로가
    // 구조적으로 막힌다. 화면(발주 관리)도 관리자 전용 라우트라 이중으로 잠긴다.
    match /supplierOrders/{orderId} {
      allow read, write: if isAdmin();
      // 협력사 계정은 자기 앞으로 연동된(partnerId == 본인 uid) 발주서만 조회 가능 — 쓰기는
      // 여전히 관리자 전용. 쿼리(where('partnerId','==',내 uid))가 규칙 조건과 정확히
      // 일치해서 list도 안전하다(hiddenFromPartner 때와 달리 문서마다 값이 갈리는 필드가
      // 아니라 쿼리 자체가 이미 그 값으로 좁혀져 있어서 걸러줄 필요가 없다).
      allow get, list: if isSignedIn() && myProfile().role == 'partner' && resource.data.partnerId == request.auth.uid;
    }

    // ---- work-intake 업로드 내역 (별도 내부 도구용 로그, 관리자 전용) ----
    // pm-platform과 같은 Firebase 프로젝트를 공유하는 별도 앱(work-intake)이 파일 업로드 직후
    // "최근 업로드 내역" 조회용으로 남기는 로그. 실제 파일/코멘트는 tasks/{taskId}/files·comments에
    // 그대로 남고, 이 컬렉션은 그 요약만 별도로 빠르게 훑어보기 위한 용도다.
    match /workIntakeUploads/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
