rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // firestore.rules의 myProfile()과 같은 목적이지만, Storage 규칙은 Firestore 규칙 파일과
    // 별도로 배포되는 완전히 다른 규칙 엔진이라 함수를 공유할 수 없어 그대로 다시 적는다.
    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    // 한때 clientId 소유권까지 firestore.get()으로 검사하도록 좁혔었는데(다른 회사 고객이
    // projectId만 알아내면 접근 가능하던 구멍을 막으려는 시도), 실제 운영 환경에서 Storage
    // 규칙의 firestore.get() 교차 서비스 호출이 기대대로 동작하지 않아 관리자 본인의 정상
    // 업로드까지 "업로드 권한이 없습니다" 오류로 막아버리는 회귀가 생겼다. 업무 중단이 더
    // 급한 문제라 우선 로그인 여부만 확인하는 원래 방식으로 되돌린다 — clientId 소유권 검사는
    // firestore.get() 대신 커스텀 클레임(Custom Claims) 등 더 안정적인 방식으로 다시 시도할 것.
    // 업무별 첨부 파일: projects/{projectId}/tasks/{taskId}/{fileName}
    // 프로젝트 삭제 시 하위 파일을 한꺼번에 조회/삭제할 수 있도록 프로젝트 전체 경로에 대해 list 권한도 허용
    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 클라이언트 브랜드 로고
    match /clients/{clientId}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 발주 제품 카탈로그 이미지
    match /clientProducts/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 발주 요청 시 클라이언트 서명 이미지
    match /purchaseOrders/{orderId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 계약 전자서명 이미지 — 실제 업로드는 Cloud Functions(Admin SDK)가 수행해 이 write
    // 규칙은 우회되지만, 다른 경로들과의 일관성을 위해 동일하게 유지한다.
    match /contracts/{contractId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 매입 전용 품목 사진 — 발주서 PDF에도 실려야 하는데 인쇄 시점에는 인증 헤더를 붙일 수
    // 없으므로, 다른 제품 사진들과 같이 읽기를 열어둔다. 사진에 금액은 없어서 원가 노출과 무관하다.
    match /supplierProducts/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 계약서 등에 쓰이는 공용 브랜드 자산(을 직인 이미지 등) — 로그인 없는 상대방도 서명
    // 페이지·이메일에서 봐야 하므로 읽기는 항상 허용한다.
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 견적 수락 시 고객이 첨부하는 사업자등록증 — 사업자등록번호 등 민감 정보가 담겨 있어
    // 이전처럼 완전 공개(read: true)로 두지 않고 관리자 로그인을 요구한다. 관리자 화면
    // (quotes/page.tsx, contracts/page.tsx)에서는 <a href>가 아니라
    // openAuthenticatedStorageFile()(SDK의 인증된 요청으로 blob을 받아옴)로 열람한다 —
    // 단순 <a href> 링크는 브라우저가 인증 헤더를 붙이지 않아 이 규칙에 막히기 때문이다.
    // (파일명이 bizRegCert.*인 것만 해당 — 아래 상담 자료 파일은 원래도 관리자 전용이었다.)
    match /quoteRequests/{quoteId}/{fileName} {
      allow read: if isAdmin() && fileName.matches('bizRegCert[.].*');
    }

    // 견적 요청 상담 중(대면/화상 미팅) 이메일 등으로 추가로 받는 자료 아카이브 — 견적 요청
    // 자체가 관리자 전용 데이터라 이 경로도 관리자만 쓴다. (기존엔 "관리자만"이라는 주석과
    // 달리 실제로는 로그인만 있으면 통과되던 코드-주석 불일치가 있어 함께 바로잡는다.)
    match /quoteRequests/{quoteId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
