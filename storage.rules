rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // 예전엔 여기에 firestore.get()으로 Firestore의 users/projects 문서를 들여다봐서
    // 관리자 여부·clientId 소유권까지 검사하려 했었다 — 그런데 실제 배포해보니
    // "Invalid function name: firestore.get" 경고가 뜬다: Storage 규칙 언어에는 애초에
    // firestore.get()이라는 함수가 없다(Firestore 규칙과 달리 Storage 규칙은 다른 서비스의
    // 문서를 들여다볼 방법이 없다). 그래서 그 함수를 쓰던 isAdmin()/clientId 검사는 관리자
    // 여부와 무관하게 항상 실패해, 정상적인 관리자 업로드·열람까지 "권한 없음"으로 막고
    // 있었다. 로그인 여부만 확인하는 걸로 되돌렸다 — 관리자 전용/소유권 검사가 다시
    // 필요해지면 Firebase Auth 커스텀 클레임(Custom Claims)처럼 Storage 규칙 안에서
    // request.auth.token으로 바로 읽을 수 있는 방식을 써야 한다.
    // 업무별 첨부 파일: projects/{projectId}/tasks/{taskId}/{fileName}
    // 프로젝트 삭제 시 하위 파일을 한꺼번에 조회/삭제할 수 있도록 프로젝트 전체 경로에 대해 list 권한도 허용
    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 협력사 자료함(관리자 ↔ 협력사 전용) 첨부 파일: partnerArchive/{projectId}/{fileName}
    // 다른 경로들과 같은 이유로 소유권/역할 검사는 Storage 규칙에서 할 수 없으니 로그인
    // 여부만 확인하고, "누가 이 프로젝트의 자료함에 접근할 수 있는지"는 실제 파일 목록을
    // 제공하는 Firestore 쪽 규칙(partnerArchiveFiles)이 가른다 — URL을 모르면 애초에
    // 접근할 방법이 없다.
    match /partnerArchive/{projectId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 협력사 청구서 지급 영수증: supplierInvoiceReceipts/{invoiceId}/{fileName}
    // 같은 이유로 Storage 쪽에서는 로그인 여부만 확인하고, 실제 접근 가능 여부는
    // Firestore 쪽 규칙(supplierInvoices)이 가른다.
    match /supplierInvoiceReceipts/{invoiceId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 클라이언트 브랜드 로고
    match /clients/{clientId}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 발주 제품 카탈로그 이미지
    match /clientProducts/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 발주 요청 시 클라이언트 서명 이미지
    match /purchaseOrders/{orderId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 계약 전자서명 이미지 — 실제 업로드는 Cloud Functions(Admin SDK)가 수행해 이 write
    // 규칙은 우회되지만, 다른 경로들과의 일관성을 위해 동일하게 유지한다.
    match /contracts/{contractId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 매입 전용 품목 사진 — 발주서 PDF에도 실려야 하는데 인쇄 시점에는 인증 헤더를 붙일 수
    // 없으므로, 다른 제품 사진들과 같이 읽기를 열어둔다. 사진에 금액은 없어서 원가 노출과 무관하다.
    match /supplierProducts/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 계약서 등에 쓰이는 공용 브랜드 자산(을 직인 이미지 등) — 로그인 없는 상대방도 서명
    // 페이지·이메일에서 봐야 하므로 읽기는 항상 허용한다.
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 견적 수락 시 고객이 첨부하는 사업자등록증 — 사업자등록번호 등 민감 정보가 담겨 있어
    // 완전 공개(read: true)는 피하고 싶었지만, 위와 같은 이유(firestore.get() 자체가 Storage
    // 규칙에 없는 함수)로 관리자 전용 검사가 항상 실패해 관리자 본인의
    // openAuthenticatedStorageFile() 열람 시도까지 조용히 막고 있었다. 우선 로그인 여부만
    // 확인하는 방식으로 되돌린다 — 관리자 전용으로 더 좁히려면 커스텀 클레임을 써야 한다.
    // (파일명이 bizRegCert.*인 것만 해당 — 아래 상담 자료 파일은 원래도 관리자 전용이었다.)
    match /quoteRequests/{quoteId}/{fileName} {
      allow read: if isSignedIn() && fileName.matches('bizRegCert[.].*');
    }

    // 견적 요청 상담 중(대면/화상 미팅) 이메일 등으로 추가로 받는 자료 아카이브 — 견적 요청
    // 자체가 관리자 전용 데이터라 이 경로도 원래는 관리자만 써야 하지만, 위와 같은 이유로
    // 우선 로그인 여부만 확인한다.
    match /quoteRequests/{quoteId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
