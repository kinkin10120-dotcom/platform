rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 업무별 첨부 파일: projects/{projectId}/tasks/{taskId}/{fileName}
    // 프로젝트 삭제 시 하위 파일을 한꺼번에 조회/삭제할 수 있도록 프로젝트 전체 경로에 대해 list 권한도 허용
    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 클라이언트 브랜드 로고
    match /clients/{clientId}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 발주 제품 카탈로그 이미지
    match /clientProducts/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 발주 요청 시 클라이언트 서명 이미지
    match /purchaseOrders/{orderId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 계약 전자서명 이미지 — 실제 업로드는 Cloud Functions(Admin SDK)가 수행해 이 write
    // 규칙은 우회되지만, 다른 경로들과의 일관성을 위해 동일하게 유지한다.
    match /contracts/{contractId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 매입 전용 품목 사진 — 발주서 PDF에도 실려야 하는데 인쇄 시점에는 인증 헤더를 붙일 수
    // 없으므로, 다른 제품 사진들과 같이 읽기를 열어둔다. 사진에 금액은 없어서 원가 노출과 무관하다.
    match /supplierProducts/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 계약서 등에 쓰이는 공용 브랜드 자산(을 직인 이미지 등) — 로그인 없는 상대방도 서명
    // 페이지·이메일에서 봐야 하므로 읽기는 항상 허용한다.
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 견적 수락 시 고객이 첨부하는 사업자등록증 — 계약서 쪽(/contracts/{contractId})과
    // 동일하게 관리자가 링크를 눌러 바로 열어볼 수 있어야 하므로 읽기는 공개로 둔다.
    // (파일명이 bizRegCert.*인 것만 해당 — 아래 상담 자료 파일은 계속 인증이 필요하다.)
    match /quoteRequests/{quoteId}/{fileName} {
      allow read: if fileName.matches('bizRegCert[.].*');
    }

    // 견적 요청 상담 중(대면/화상 미팅) 이메일 등으로 추가로 받는 자료 아카이브 — 견적 요청
    // 자체가 관리자 전용 데이터라 이 경로도 관리자만 쓴다.
    match /quoteRequests/{quoteId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
