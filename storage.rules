rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 업무별 첨부 파일: projects/{projectId}/tasks/{taskId}/{fileName}
    match /projects/{projectId}/tasks/{taskId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // 클라이언트 브랜드 로고
    match /clients/{clientId}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
